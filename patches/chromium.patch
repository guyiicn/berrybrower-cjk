+
+size_t BerryBrowserChrome::TextOffset(size_t wide_index) const {
+  const auto wide = base::UTF16ToWide(edit_text_);
+  return base::WideToUTF16(std::wstring_view(wide).substr(
+      0, std::min(wide_index, wide.size()))).size();
+}
+
+void BerryBrowserChrome::InsertText(std::u16string text, int cursor) {
+  const auto range = EditRange();
+  edit_text_.replace(range.GetMin(), range.length(), text);
+  const auto wide = base::UTF16ToWide(edit_text_);
+  const size_t start = base::UTF16ToWide(
+      std::u16string_view(edit_text_).substr(0, range.GetMin())).size();
+  const int64_t target = cursor > 0
+      ? static_cast<int64_t>(start + base::UTF16ToWide(text).size()) + cursor - 1
+      : static_cast<int64_t>(start) + cursor;
+  selection_ = gfx::Range(TextOffset(
+      std::clamp<int64_t>(target, 0, wide.size())));
+  FinishComposition();
+}
+
+void BerryBrowserChrome::ComposeText(std::u16string text, int cursor) {
+  const auto range = EditRange();
+  InsertText(text, cursor);
+  composition_ = gfx::Range(range.GetMin(), range.GetMin() + text.size());
+}
+
+void BerryBrowserChrome::FinishComposition() {
+  composition_ = gfx::Range::InvalidRange();
+}
+
+void BerryBrowserChrome::DeleteSurrounding(int before, int after) {
+  if (before < 0 || after < 0)
+    return;
+  const size_t start = base::UTF16ToWide(
+      std::u16string_view(edit_text_).substr(0, selection_.GetMin())).size();
+  const size_t end = base::UTF16ToWide(
+      std::u16string_view(edit_text_).substr(0, selection_.GetMax())).size();
+  const size_t left = TextOffset(start - std::min(start, static_cast<size_t>(before)));
+  const size_t right = TextOffset(end + static_cast<size_t>(after));
+  edit_text_.erase(left, right - left);
+  selection_ = gfx::Range(left);
+  FinishComposition();
+}
+
+void BerryBrowserChrome::Select(int anchor, int cursor) {
+  if (anchor >= 0 && cursor >= 0)
+    selection_ = gfx::Range(TextOffset(anchor), TextOffset(cursor));
+}
+
+void BerryBrowserChrome::ComposeRegion(int start, int end) {
+  if (start >= 0 && end >= start)
+    composition_ = gfx::Range(TextOffset(start), TextOffset(end));
+}
+
+void BerryBrowserChrome::MoveCursor(int direction) {
+  const size_t offset = direction < 0 ? selection_.GetMin() : selection_.GetMax();
+  const auto wide = base::UTF16ToWide(
+      std::u16string_view(edit_text_).substr(0, offset));
+  const size_t index = wide.size();
+  const size_t next = !selection_.is_empty() ? index :
+      direction < 0 ? index - (index != 0) : index + 1;
+  selection_ = gfx::Range(TextOffset(next));
+  FinishComposition();
 }
 
