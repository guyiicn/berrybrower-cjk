+    if (!g_chrome || !g_url_bar_editing)
+      return;
+    switch (edit) {
+      case ui::QnxSystemInput::Edit::kCommit:
+        g_chrome->InsertText(std::move(text), first);
+        break;
+      case ui::QnxSystemInput::Edit::kCompose:
+        g_chrome->ComposeText(std::move(text), first);
+        break;
+      case ui::QnxSystemInput::Edit::kFinish:
+        g_chrome->FinishComposition();
+        break;
+      case ui::QnxSystemInput::Edit::kDelete:
+        g_chrome->DeleteSurrounding(first, second);
+        break;
+      case ui::QnxSystemInput::Edit::kSelect:
+        g_chrome->Select(first, second);
+        break;
+      case ui::QnxSystemInput::Edit::kComposeRegion:
+        g_chrome->ComposeRegion(first, second);
+        break;
+    }
